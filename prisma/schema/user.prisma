model User{
   id String @id @default(uuid())
   name String
   email String @unique
   password String
   phone String
   role Role 
   status UserStatus @default(ACTIVE)
   profileImage String?
   createdAt DateTime @default(now())
   updatedAt DateTime @updatedAt

   technician Technician?
booking Booking[]
   reviews Review[]
   payments Payment[]


   @@map("users")
}                       

